// Module aliases
const { Engine, Render, Runner, Bodies, Composite, Mouse, MouseConstraint } = Matter;

// 1. Create a Matter.js engine
const engine = Engine.create();
const world = engine.world;

// 2. Create the renderer attached to the browser window size
const render = Render.create({
    element: document.body,
    engine: engine,
    options: {
        width: window.innerWidth,
        height: window.innerHeight,
        wireframes: false,
        background: '#121212'
    }
});

Render.run(render);

// 3. Create a runner to keep the physics looping
const runner = Runner.create();
Runner.run(runner, engine);

// 4. Create boundary walls so objects stay on screen
const wallOptions = { isStatic: true, render: { fillStyle: '#222' } };
const ground = Bodies.rectangle(window.innerWidth / 2, window.innerHeight + 30, window.innerWidth, 60, wallOptions);
const ceiling = Bodies.rectangle(window.innerWidth / 2, -30, window.innerWidth, 60, wallOptions);
const leftWall = Bodies.rectangle(-30, window.innerHeight / 2, 60, window.innerHeight, wallOptions);
const rightWall = Bodies.rectangle(window.innerWidth + 30, window.innerHeight / 2, 60, window.innerHeight, wallOptions);

Composite.add(world, [ground, ceiling, leftWall, rightWall]);

// 5. Add skill blocks that drop down and can be dragged/thrown around
const skills = ['JavaScript', 'Emacs', 'React', 'Matter.js', 'HTML/CSS', 'Node.js', 'Git'];
skills.forEach((skill, index) => {
    const x = 100 + (index * 120) % (window.innerWidth - 200);
    const y = 50 + (index * 50);
    
    const box = Bodies.rectangle(x, y, 100, 40, {
        render: {
            fillStyle: '#00ffcc',
            strokeStyle: '#ffffff',
            lineWidth: 1
        }
    });
    
    Composite.add(world, box);
});

// 6. Enable mouse control to drag objects
const mouse = Mouse.create(render.canvas);
const mouseConstraint = MouseConstraint.create(engine, {
    mouse: mouse,
    constraint: {
        stiffness: 0.2,
        render: { visible: false }
    }
});

Composite.add(world, mouseConstraint);
render.mouse = mouse;

// Handle window resizing dynamically
window.addEventListener('resize', () => {
    render.canvas.width = window.innerWidth;
    render.canvas.height = window.innerHeight;
});
