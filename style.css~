body, html {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #121212;
    color: #ffffff;
}

#ui-layer {
    position: absolute;
    top: 20px;
    left: 20px;
    z-index: 10;
    pointer-events: none; /* Allows mouse clicks to pass through to the Matter.js canvas */
}

#ui-layer * {
    pointer-events: auto; /* Re-enables clicks for your text and links */
}

header h1 {
    margin: 0;
    font-size: 2.5rem;
    color: #00ffcc;
}

header p {
    color: #888;
}

.about {
    margin-top: 20px;
    background: rgba(25, 25, 25, 0.8);
    padding: 15px;
    border-radius: 8px;
    border: 1px solid #333;
    max-width: 400px;
}
